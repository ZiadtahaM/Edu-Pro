# Edu-Pro Portal Environment Variables
NODE_ENV=development
PORT=4173

# Database (Optional: falls back to in-memory store in local dev)
DATABASE_URL=

# JWT & Session Secret
JWT_SECRET=edu-pro-default-dev-jwt-secret-key-32-chars-minimum

# Upstream NestJS Backend API (Optional: defaults to http://localhost:3000)
EDU_PRO_API_URL=http://localhost:3000

# Cloud OAuth (Optional: local dev-login enabled by default)
VITE_APP_ID=edu-pro-app
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=dev-admin-user
